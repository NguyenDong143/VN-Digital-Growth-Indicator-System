# =========================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================
# Copy this file to `.env` and fill in your own values:
#
#     Copy-Item .env.example .env
#
# `.env` is gitignored — never commit real secrets.
# On Streamlit Cloud, set the same keys under the app's "Secrets" tab;
# those values take priority over anything in `.env`.

# Admin self-registration secret. When set, users can create an Admin account
# by entering this value as the "Mã bảo mật Admin". Leave empty to disable
# Admin registration entirely.
ADMIN_SECRET=

# Password policy / rate limiting (optional — defaults shown).
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_SECONDS=3600